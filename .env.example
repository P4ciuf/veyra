# database
DATABASE_CONNECTION_STRING=postgresql://user:...@db:5432/name_db
POSTGRES_USER=user
POSTGRES_PASSWORD=...
POSTGRES_DB=name_db

# discord bot & discord auth
DISCORD_TOKEN=...
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...

# github auth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# google auth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Public base URL used to build OAuth callback URLs; register
# <NEXTAUTH_URL>/api/auth/callback/{github,google,discord} in each provider console.
NEXTAUTH_URL=https://example.com
# Required by NextAuth on the site's auth routes; generate a random value.
NEXTAUTH_SECRET=...

# general
# Leave empty to use production; set to "development" for debug logs.
NODE_ENV=
