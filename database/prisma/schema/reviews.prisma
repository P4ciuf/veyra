/// A user's star rating and written review.
/// The model has no bot relation yet: associating reviews with catalog bots
/// is not implemented in the data layer. The plural model name is the current
/// Prisma identifier.
model Reviews {
  id            String @id @default(cuid())
  discordUserId String

  stars   Int
  content String

  user User @relation(fields: [discordUserId], references: [discordId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}
