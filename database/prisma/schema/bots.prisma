/// Catalog category used to group bots; the unique `name` is also the foreign
/// key referenced by `Bot.categoryName`.
model BotCategory {
  id String @id @default(cuid())

  name String @unique

  Bots Bot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A published bot entry in the catalog. `filePath` points at the artifact of
/// the currently published version; `version` is a denormalized mirror of
/// `BotVersion.version` kept for existing consumers. Independent versions are
/// stored in `BotVersion`, so older releases remain addressable and immutable.
model Bot {
  id String @id @default(cuid())

  name         String
  categoryName String
  version      String

  filePath String

  category      BotCategory    @relation(fields: [categoryName], references: [name])
  /// Every published release, including the ones superseded by a newer version.
  versions      BotVersion[]
  /// Packages generated for users from any version of this bot.
  distributions Distribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An immutable, independently addressable release of a catalog bot.
/// `version` is unique per bot, so a repository can publish several releases
/// without overwriting the metadata or artifact of an older one.
model BotVersion {
  id String @id @default(cuid())

  botId     String
  /// Semver string as declared in the bot's `veyra.json`; unique per bot.
  version   String
  /// Path of the stored source artifact for this exact release.
  filePath  String
  /// Human-readable release notes; optional because the manifest does not require them.
  changelog String?

  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// Distributions created from this release. Restricting deletion keeps history consistent.
  distributions Distribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, version])
}

/// A user's request to add a bot to the catalog.
/// The lowercase model name is the current Prisma identifier and is kept to
/// avoid a migration solely for naming.
model botAddRequest {
  id            String @id @default(cuid())
  discordUserId String

  githubRepository String
  botName          String
  version          String

  user User @relation(fields: [discordUserId], references: [discordId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
