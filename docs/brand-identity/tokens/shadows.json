  "borders": {
    "border-width-default": {
      "value": "1px",
      "description": "Default border."
    },
    "border-width-emphasis": {
      "value": "2px",
      "description": "Selected/error emphasis; never a replacement for focus ring."
    }
  },
  "focus": {
    "focus-ring": {
      "value": "0 0 0 2px var(--vy-bg-app), 0 0 0 4px var(--vy-focus-ring)",
      "description": "Box-shadow focus-visible ring (2px gap + 2px ring). Prefer outline where possible; use this when parent has overflow hidden or radius must be followed."
    },
    "focus-outline": {
      "value": "2px solid var(--vy-focus-ring)",
      "description": "Standard outline; pair with outline-offset: 2px."
    }
  },
  "usage-rule": "Shadows alone do not convey elevation on dark backgrounds. Elevated surfaces also use the lighter bg-elevated color and, where needed, border-default."
}
